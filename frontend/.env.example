# Base URL of the IPO Checker FastAPI service.
# Copy this file to `.env.local` and adjust if the API runs elsewhere.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only (never prefixed with NEXT_PUBLIC_): must match API_TOKEN in
# backend/.env.local. The Next server adds it to every backend call that
# needs it (chat, research, subscriptions), so it never reaches the browser.
API_TOKEN=change-me

# Google sign-in (Auth.js). Chat, AI research and the daily email need it.
# AUTH_SECRET encrypts the session cookie: any long random string
# (`npx auth secret` makes one). The Google client comes from Google Cloud
# Console > APIs & Services > Credentials > OAuth client ID (Web application),
# with the redirect URI http://localhost:3000/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
