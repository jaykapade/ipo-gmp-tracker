# Copy this file to .env and adjust the values you need.
# Every setting has a safe default, so the pipeline also works without .env.

# Database
IPO_DB_PATH=data/ipo_intelligence.db

# Screening
MIN_GMP_PERCENT=20
INCLUDE_UPCOMING=false

# Scheduled research: `run --research` reuses completed AI research newer than this
RESEARCH_MAX_AGE_HOURS=24

# HTTP
REQUEST_TIMEOUT=30
REQUEST_DELAY_SECONDS=1.0
USER_AGENT=IPO-Checker/0.1 (personal research; polite scraper)

# Sources (override only when a report ID or endpoint changes)
INVESTORGAIN_REPORT_ID=331
INVESTORGAIN_YEAR=2026
INVESTORGAIN_FISCAL_YEAR=2026-27
# INVESTORGAIN_URL=https://webnodejs.investorgain.com/cloud/v2/report/data-read/331/1/9/2026/2026-27/0/all?search=&v=19-49
# INVESTORGAIN_PAGE_URL=https://www.investorgain.com/report/live-ipo-gmp/331/   # linked as a source in reports
# IPOWATCH_API_URL=https://ipowatch.in/server/api/ipo/GetIpoListingByStatus

# Reporting
REPORT_OUTPUT_DIR=reports

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com
EMAIL_SUBJECT_PREFIX=[IPO Checker]
# Public frontend URL used in subscriber confirm/unsubscribe links.
SITE_URL=http://localhost:3000
# Send subscribers the full research report + PDF instead of the short digest
# (notify --research). It uses stored research, so run `run --research` first.
DIGEST_RESEARCH=false

# AI (optional; local or cloud through one provider interface)
# Off by default — the pipeline and chat stay fully functional without a model.
# Providers: ollama | lmstudio | llamacpp | vllm | openai-compatible |
#            openai | openrouter | groq | anthropic | gemini |
#            claude-code (Claude Pro/Max subscription via the `claude` CLI)
LLM_ENABLED=false
LLM_PROVIDER=ollama            # chat provider (config-only switching)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=                   # required only for cloud providers
LLM_MODEL=qwen2.5:7b-instruct
LLM_EMBED_PROVIDER=ollama      # may differ from the chat provider
LLM_EMBED_MODEL=nomic-embed-text
LLM_EMBED_BASE_URL=            # defaults to the provider default (or LLM_BASE_URL)
LLM_FALLBACK_PROVIDERS=        # optional chain, e.g. ollama,openai
LLM_ALLOW_CLOUD=false          # explicit opt-in before documents leave the machine
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONTEXT=8192
LLM_CACHE=true
LLM_MAX_CONCURRENCY=2          # parallel claude-code CLI calls (subscription rate limits)
RERANK_PROVIDER=llm            # llm (extractor role scores passages) | identity

# Per-role routing (docs/ipo-research-framework.md §P4). Unset fields inherit
# the LLM_* values above; LLM_ROLE_<ROLE>_{PROVIDER,MODEL,BASE_URL,API_KEY,FALLBACKS}.
# The challenger stays off until LLM_ROLE_CHALLENGER_MODEL is set.
# Fallback entries may pin a model: LLM_FALLBACK_PROVIDERS=ollama=qwen3.5:9b-q4_K_M

# --- Profile: local (free, private) --------------------------------------------
# LLM_PROVIDER=ollama
# LLM_ROLE_ANALYST_MODEL=qwen3.5:9b-q4_K_M
# LLM_ROLE_VERIFIER_MODEL=gemma4:12b
# LLM_ROLE_EXTRACTOR_MODEL=qwen3.5:4b-q4_K_M
# LLM_ROLE_CHALLENGER_MODEL=gpt-oss:20b
# LLM_ROLE_EMBEDDER_MODEL=qwen3-embedding:0.6b

# --- Profile: Claude subscription (PERSONAL USE ONLY) ---------------------------
# Needs `claude auth login` with your Pro/Max account; no API key. LLM_BASE_URL
# may point at the claude executable if it is not on PATH.
# LLM_ENABLED=true
# LLM_ALLOW_CLOUD=true
# LLM_PROVIDER=claude-code
# LLM_BASE_URL=
# LLM_MODEL=claude-sonnet-5-5
# LLM_ROLE_ANALYST_MODEL=claude-sonnet-5-5
# LLM_ROLE_VERIFIER_MODEL=claude-opus-5-5
# LLM_ROLE_EXTRACTOR_MODEL=claude-haiku-5-5
# LLM_ROLE_CHALLENGER_MODEL=claude-opus-5-5
# LLM_EMBED_PROVIDER=ollama              # Claude has no embeddings; stay local
# LLM_EMBED_MODEL=qwen3-embedding:0.6b
# LLM_FALLBACK_PROVIDERS=ollama=qwen3.5:9b-q4_K_M

# --- Profile: commercial / multi-user ------------------------------------------
# Same as the subscription profile with two changes — model ids stay identical:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...

# API / frontend
API_HOST=127.0.0.1
API_PORT=8000
API_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
