# Copy this file to .env and adjust the values you need.
# Every setting has a safe default, so the pipeline also works without .env.

# Database
IPO_DB_PATH=data/ipo_intelligence.db

# Screening
MIN_GMP_PERCENT=20
INCLUDE_UPCOMING=false

# HTTP
REQUEST_TIMEOUT=30
REQUEST_DELAY_SECONDS=1.0
USER_AGENT=IPO-Checker/0.1 (personal research; polite scraper)

# Sources (override only when a report ID or endpoint changes)
INVESTORGAIN_REPORT_ID=331
INVESTORGAIN_YEAR=2026
INVESTORGAIN_FISCAL_YEAR=2026-27
# INVESTORGAIN_URL=https://webnodejs.investorgain.com/cloud/v2/report/data-read/331/1/9/2026/2026-27/0/all?search=&v=19-49
# IPOWATCH_API_URL=https://ipowatch.in/server/api/ipo/GetIpoListingByStatus

# Reporting
REPORT_OUTPUT_DIR=reports

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com
EMAIL_SUBJECT_PREFIX=[IPO Checker]

# AI (optional; local or cloud through one provider interface)
# Off by default — the pipeline and chat stay fully functional without a model.
# Providers: ollama | lmstudio | llamacpp | vllm | openai-compatible |
#            openai | openrouter | groq | anthropic | gemini
LLM_ENABLED=false
LLM_PROVIDER=ollama            # chat provider (config-only switching)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=                   # required only for cloud providers
LLM_MODEL=qwen2.5:7b-instruct
LLM_EMBED_PROVIDER=ollama      # may differ from the chat provider
LLM_EMBED_MODEL=nomic-embed-text
LLM_EMBED_BASE_URL=            # defaults to the provider default (or LLM_BASE_URL)
LLM_FALLBACK_PROVIDERS=        # optional chain, e.g. ollama,openai
LLM_ALLOW_CLOUD=false          # explicit opt-in before documents leave the machine
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONTEXT=8192
LLM_CACHE=true

# API / frontend
API_HOST=127.0.0.1
API_PORT=8000
API_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
